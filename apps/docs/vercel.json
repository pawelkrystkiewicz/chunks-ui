{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "master": true,
      "**/*-preview": true
    }
  },
  "ignoreCommand": "npx -y turbo@2.11.9 query affected --base=$VERCEL_GIT_PREVIOUS_SHA --packages @chunks-ui/docs --exit-code || exit 1"
}
