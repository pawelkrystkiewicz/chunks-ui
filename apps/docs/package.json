{
  "name": "@chunks-ui/docs",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "generate:llm": "bun run scripts/generate-llm-txt.ts",
    "dev": "next dev -p 3005",
    "prebuild": "bun run generate:llm",
    "build": "next build",
    "postbuild": "bun run scripts/build-search-index.ts",
    "start": "next start -p 3005",
    "lint": "biome check .",
    "check-types": "tsc --noEmit && tsc -p scripts && bun run check:snippets && bun run check:props",
    "check:snippets": "bun run scripts/check-snippets.ts",
    "generate:props": "bun run scripts/generate-props.ts",
    "check:props": "bun run scripts/generate-props.ts --check",
    "check:a11y": "bun run scripts/check-a11y.ts",
    "test": "vitest run",
    "test:unit:coverage": "bun run test",
    "clean": "rm -rf .turbo node_modules .next"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-table": "^9.3.1",
    "chunks-ui": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "motion": "^14.7.1",
    "lucide-react": "^1.64.0",
    "next": "^16.4.3",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@chunks-ui/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "pagefind": "^1.5.2",
    "playwright": "1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "vitest": "^5.0.5"
  }
}
