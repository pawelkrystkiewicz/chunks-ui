{
  "name": "chunks-ui-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "check-types": "turbo run check-types",
    "clean": "turbo run clean && rm -rf node_modules",
    "test": "turbo run test && bun test ./scripts",
    "test:unit:coverage": "turbo run test:unit:coverage",
    "test:visual": "turbo run test:visual --",
    "test:visual:update": "turbo run test:visual:update --",
    "test:webkit": "turbo run test:webkit --",
    "format": "biome format --write .",
    "lint:scripts": "biome check scripts",
    "check-types:scripts": "tsc -p scripts",
    "gates": "bun scripts/gates.ts",
    "gates:full": "bun scripts/gates.ts --full",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install --lockfile-only",
    "release": "npm view chunks-ui-core name > /dev/null && turbo run build --filter=chunks-ui && bun run --cwd packages/core check:exports && bun run --cwd packages/core check:dist && bun run --cwd packages/ui check:exports && bun run --cwd packages/ui check:dist && changeset publish",
    "update:screenshots": "sh scripts/update-screenshots.sh",
    "check:playwright": "bun scripts/check-playwright-version.ts",
    "check:bun": "bun scripts/check-bun-version.ts",
    "check:docs-direction": "bun scripts/check-docs-direction.ts",
    "check:tailwind": "turbo run build --filter=chunks-ui && bun scripts/check-tailwind-compat.ts",
    "check:no-motion": "turbo run build --filter=chunks-ui && bun scripts/check-no-motion.ts",
    "generate:llm": "turbo run generate:llm --filter=@chunks-ui/docs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^2.31.1",
    "@types/bun": "^1.4.3",
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.3.2",
    "lefthook": "^2.2.2",
    "playwright": "1.64.1",
    "turbo": "^2.11.9"
  },
  "overrides": {
    "zod": "~4.3.6"
  },
  "packageManager": "bun@1.4.3",
  "peerDependencies": {
    "typescript": "^5.9.3"
  }
}
