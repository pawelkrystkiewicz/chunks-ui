{
  "name": "chunks-ui",
  "version": "0.2.0",
  "description": "React 19.2+ component library built on Base UI, Tailwind CSS v4 and optional Motion animations.",
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/utils.d.ts",
        "default": "./dist/utils.js"
      },
      "require": {
        "types": "./dist/utils.d.cts",
        "default": "./dist/utils.cjs"
      }
    },
    "./theme.css": "./dist/theme.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "utils": [
        "./dist/utils.d.ts"
      ]
    }
  },
  "engines": {
    "node": ">=22.23.3"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:visual": "vitest run --config vitest.visual.config.ts",
    "test:visual:update": "vitest run --config vitest.visual.config.ts --update=true",
    "test:webkit": "vitest run --config vitest.webkit.config.ts",
    "lint": "biome check .",
    "check-types": "tsc --noEmit && tsc --noEmit --project tsconfig.visual.json && tsc -p scripts && tsc --noEmit -p tsconfig.node.json",
    "check:dist": "bun run scripts/check-dist.ts",
    "check:exports": "attw --pack . --exclude-entrypoints ./theme.css",
    "clean": "rm -rf .turbo node_modules dist coverage"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "motion": "^12.8.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "motion": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@base-ui/react": "^1.9.0",
    "@chunks-ui/typescript-config": "workspace:*",
    "@fontsource-variable/manrope": "5.3.0",
    "class-variance-authority": "^0.7.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser": "^4.1.12",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "axe-core": "4.14.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^28.1.0",
    "motion": "^12.43.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pawelkrystkiewicz/chunks-ui.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/pawelkrystkiewicz/chunks-ui/issues"
  },
  "homepage": "https://github.com/pawelkrystkiewicz/chunks-ui#readme",
  "keywords": [
    "react",
    "components",
    "ui",
    "tailwind",
    "tailwind-css",
    "base-ui",
    "headless",
    "motion",
    "animation",
    "accessible",
    "typescript",
    "react-19"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
