{
  "$schema": "https://biomejs.dev/schemas/2.4.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": ["RadioRoot"]
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.spec.tsx", "**/*.spec.ts", "**/*.test.tsx", "**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/ui/**/*.tsx", "packages/ui/**/*.jsx"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": ["PascalCase"]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/ui/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": {
                    "importNames": ["default"],
                    "message": "Import React by name or as a namespace: a default import makes the typings fail on moduleResolution node10 without esModuleInterop (#463)."
                  },
                  "react-dom": {
                    "importNames": ["default"],
                    "message": "Import React by name or as a namespace: a default import makes the typings fail on moduleResolution node10 without esModuleInterop (#463)."
                  },
                  "react/jsx-runtime": {
                    "importNames": ["default"],
                    "message": "Import React by name or as a namespace: a default import makes the typings fail on moduleResolution node10 without esModuleInterop (#463)."
                  },
                  "react-dom/client": {
                    "importNames": ["default"],
                    "message": "Import React by name or as a namespace: a default import makes the typings fail on moduleResolution node10 without esModuleInterop (#463)."
                  },
                  "react-dom/server": {
                    "importNames": ["default"],
                    "message": "Import React by name or as a namespace: a default import makes the typings fail on moduleResolution node10 without esModuleInterop (#463)."
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "cssModules": false,
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
