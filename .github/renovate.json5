{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", ":timezone(Europe/Warsaw)"],
  schedule: ["before 10am on monday"],
  labels: ["dependencies", "renovate"],
  assignees: ["pawelkrystkiewicz"],
  dependencyDashboard: true,
  prHourlyLimit: 3,
  prConcurrentLimit: 20,
  branchConcurrentLimit: 20,
  rangeStrategy: "bump",
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 10am on monday"],
    automerge: true,
  },
  enabledManagers: ["npm", "bun", "github-actions", "nvm", "custom.regex"],
  customManagers: [
    {
      // The docs ignoreCommand runs turbo with a hand-written version. No built-in manager reads
      // vercel.json, so the pin drifted from the root turbo devDependency (#806). The match does
      // not depend on the runner (npx, bunx, flags) and keeps prerelease suffixes; the leading
      // whitespace keeps create-turbo@ out. Both deps land in one PR through config:recommended's
      // group:monorepos (monorepo:turbo matches the npm package's source URL), so no packageRules
      // entry is needed.
      customType: "regex",
      managerFilePatterns: ["/^apps/docs/vercel\\.json$/"],
      matchStrings: ["\\sturbo@(?<currentValue>[^\\s\"]+)"],
      depNameTemplate: "turbo",
      datasourceTemplate: "npm",
    },
  ],
  automerge: false,
  automergeType: "pr",
  automergeStrategy: "squash",
  commitMessagePrefix: "⬆️ ",
  commitMessageAction: "Update",
  commitMessageTopic: "{{depName}}",
  commitMessageExtra: "to {{newVersion}}",
  ignoreDeps: [],
  packageRules: [
    {
      // Peer floors are a compatibility decision, not a freshness one: Renovate narrowed them
      // twice (motion ^12.0.0 -> ^12.43.0, react ^19.2 -> ^19.3). Bump them by hand with a changeset.
      matchDepTypes: ["peerDependencies"],
      enabled: false,
    },
    {
      matchUpdateTypes: ["patch"],
      automerge: true,
      platformAutomerge: true,
    },
    {
      matchUpdateTypes: ["minor"],
      matchCurrentVersion: "!/^0/",
      automerge: true,
      platformAutomerge: true,
    },
    {
      // Playwright packages and the CI image move together. The required visual-regression-test
      // check stays red until update-screenshots.yml is dispatched on the Renovate branch (a
      // Chromium bump moves pixels at zero tolerance). The image digest in
      // TESTING_STRATEGY.md (Visual Regression) is not managed by Renovate: bump it by hand in the same PR.
      // automerge stays off because earlier patch/minor rules set it true.
      groupName: "playwright",
      matchPackageNames: [
        "@playwright/test",
        "playwright",
        "playwright-core",
        "mcr.microsoft.com/playwright",
      ],
      automerge: false,
      platformAutomerge: false,
    },
    {
      // zod is pinned by `overrides` in package.json: from 4.4.0 a strict object rejects an absent
      // key even when its schema accepts undefined, and nextra-theme-docs 4.6.1 <Layout> validates
      // its props without `children` against a schema that lists it, so the docs build fails.
      // Lift both once nextra-theme-docs 4.6.4 (fixed in git) is on npm: publishing stopped at
      // 4.6.1. https://github.com/shuding/nextra/issues/4989
      matchPackageNames: ["zod"],
      allowedVersions: "<4.4.0",
    },
    {
      // @types/node follows the runtime major in .nvmrc: newer types typecheck calls to Node APIs
      // the runtime does not have. Lift the cap in the same PR that moves the .nvmrc major.
      matchPackageNames: ["@types/node"],
      allowedVersions: "<25",
    },
    {
      matchUpdateTypes: ["major"],
      minimumReleaseAge: "3 days",
      dependencyDashboardApproval: true,
      automerge: false,
      prPriority: -1,
      schedule: ["* 6 * * 6"],
    },
  ],
  vulnerabilityAlerts: {
    enabled: true,
    schedule: ["at any time"],
  },
}
